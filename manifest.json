{
  "manifest_version": 3,
  "name": "Popup Translator",
  "description": "Select text to translate with popup.",
  "version": "1.0",
  "permissions": ["scripting", "activeTab", "contextMenus", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}